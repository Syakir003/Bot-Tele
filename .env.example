TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=/root/Bot-Tele/serviceAccountKey.json
# Opsional: isi JSON service account satu baris. Kalau terisi, dipakai menggantikan PATH di atas.
FIREBASE_SERVICE_ACCOUNT_JSON=
# WAJIB. Kalau kosong bot terkunci (cuma jawab /myid). Cara isi: kosongin dulu, kirim /myid ke bot, salin hasilnya ke sini, restart.
OWNER_TELEGRAM_ID=
# Opsional. Default: gemini-flash-lite-latest
GEMINI_MODEL=
