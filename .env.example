# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=

# API key Gemini dari aistudio.google.com
GEMINI_API_KEY=

# URL Realtime Database Firebase, contoh: https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Isi seluruh isi file JSON service account Firebase di sini SEBAGAI SATU BARIS
# (buka file .json-nya, copy semua isinya, paste jadi satu string di sini)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Telegram ID kamu sendiri (biar bot cuma respon ke kamu). Kosongkan dulu,
# nanti kirim /myid ke bot buat tau ID kamu, baru isi sini dan restart bot.
OWNER_TELEGRAM_ID=
